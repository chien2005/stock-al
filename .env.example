# ═══════════════════════════════════════════════
# VN Stock Bot - Environment Variables Template
# Copy nội dung này vào Railway/Render Variables
# ═══════════════════════════════════════════════

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Gemini AI (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Stock symbols
STOCK_SYMBOLS=VCB,HPG,BID,MWG,SSI,FPT,VNM,VIC,MSN,CTR,MBB,E1VFVN30

# Schedule (Mon-Fri)
CRON_SCHEDULE=0 10,13,16 * * 1-5
CRON_AI_SCHEDULE=30 20 * * 1-5

# Timezone
TZ=Asia/Ho_Chi_Minh
