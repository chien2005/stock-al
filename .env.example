# ═══════════════════════════════════════════════
# VN Stock Bot v1.1.1 - Environment Variables
# Copy nội dung này vào Railway/Render Variables
# ═══════════════════════════════════════════════

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Gemini Keys (Để tránh lỗi 429 Limit, hãy dùng 3 key khác nhau)
# Lấy key: https://aistudio.google.com/apikey
GEMINI_API_KEY_AI1=your_gemini_api_key_1_here
GEMINI_API_KEY_AI2=your_gemini_api_key_2_here
GEMINI_API_KEY_AI3=your_gemini_api_key_3_here

# DeepSeek (AI 4 - Phản biện)
# Lấy key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-reasoner

# Stock symbols (phân cách bằng dấu phẩy)
STOCK_SYMBOLS=VCB,HPG,BID,MWG,SSI,FPT,VNM,VIC,MSN,CTR,MBB,E1VFVN30

# Schedule: Báo giá (Mon-Fri, 10h/13h/16h)
CRON_SCHEDULE=0 10,13,16 * * 1-5

# Schedule: AI Report cuối ngày (Mon-Fri, 20h30)
CRON_AI_SCHEDULE=30 20 * * 1-5

# Schedule: Phân tích đầu tuần (Monday, 8h30)
CRON_WEEKLY_SCHEDULE=30 8 * * 1

# Bật/tắt interactive bot (chat hỏi AI)
ENABLE_INTERACTIVE_BOT=true

# Timezone
TZ=Asia/Ho_Chi_Minh
